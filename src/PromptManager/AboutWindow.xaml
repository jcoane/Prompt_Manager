<Window x:Class="PromptManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Prompt Manager"
        Width="540"
        Height="650"
        MinWidth="480"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelInsetBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <Image x:Name="LogoImage" Source="Assets/ProtoCall_logo.png"
                       Width="220"
                       Height="220"
                       Stretch="Uniform"
                       Margin="0,0,0,12" />
                <TextBlock x:Name="TitleTextBlock" Text="Prompt Manager"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="AuthorTextBlock" Text="Autored By John-Patrick Coane"
                           FontSize="15"
                           Foreground="{StaticResource MutedInkBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="About This Software"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="DescriptionTextBlock" Text="Prompt Manager is a standalone offline Windows 11 desktop application for creating, organizing, editing, versioning, searching, copying, archiving, importing, exporting, backing up, restoring, deleting, and moving reusable prompts in a local SQLite library."
                       TextWrapping="Wrap"
                       LineHeight="20" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="#F6E3E0"
                BorderBrush="#E3B0AB"
                BorderThickness="1"
                Padding="12">
            <StackPanel>
                <TextBlock Text="Local-Only Design"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="The application runs on the local PC only. It does not require login, cloud sync, telemetry, hosted collaboration, online AI execution, or network connectivity. Prompt data is stored locally in SQLite under the user's local application data folder."
                           TextWrapping="Wrap"
                           LineHeight="20" />
            </StackPanel>
        </Border>

        <Button Grid.Row="3"
                Content="Close"
                Width="96"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Padding="10,7"
                IsDefault="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>

