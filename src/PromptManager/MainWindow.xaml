<Window x:Class="PromptManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PromptManager.Models"
        mc:Ignorable="d"
        Title="Prompt Manager"
        Icon="pack://application:,,,/PromptManager;component/Assets/PromptManager.ico"
        Width="1480"
        Height="880"
        MinWidth="1000"
        MinHeight="620"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CenterBrush}">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Margin="2,3" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{StaticResource ShellTopBrush}" Foreground="{StaticResource InkBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New Prompt" Command="{Binding NewPromptCommand}" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="_Import" Command="{Binding ImportCommand}" />
                <MenuItem Header="_Export">
                    <MenuItem Header="Selected Prompts" Command="{Binding ExportCommand}" IsEnabled="{Binding HasSelection}" />
                    <MenuItem Header="Current View" Command="{Binding ExportViewCommand}" />
                    <MenuItem Header="Entire Library" Command="{Binding ExportLibraryCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Backup Library" Command="{Binding BackupCommand}" />
                <MenuItem Header="_Restore Library" Command="{Binding RestoreCommand}" />
            </MenuItem>
            <MenuItem x:Name="ColumnsMenu" Header="_Columns" />
            <MenuItem Header="_Help">
                <MenuItem Header="_User Manual" Click="UserManualMenuItem_Click" />
                <MenuItem Header="Recovery Records" Click="RecoveryRecords_Click" />
                <Separator />
                <MenuItem Header="_About" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>
        <Border Grid.Row="1" Background="{StaticResource ShellTopBrush}" BorderBrush="{StaticResource ShellTopDarkBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="12,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="New Prompt" Command="{Binding NewPromptCommand}" Style="{StaticResource TopButtonStyle}" />
                    <Button Content="&#xE711;" Command="{Binding ClearSearchCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Clear search" />
                    <Button Content="&#xE72C;" Command="{Binding RefreshCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Refresh library" />
                </StackPanel>

                <Grid MinWidth="240" Margin="0,0,12,0">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                             VerticalContentAlignment="Center"
                             ToolTip="Search type, mode, labels, titles, tags, notes, and prompt text" />
                    <TextBlock Text="Search prompts"
                               IsHitTestVisible="False"
                               Foreground="#7A8B93"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="220" MinWidth="180" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="EditorColumn" Width="500" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="Prompt Manager" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="Views" FontWeight="SemiBold" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding Filters}"
                                 SelectedItem="{Binding SelectedFilter}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{StaticResource MutedInkBrush}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Directories" FontWeight="SemiBold" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,4" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="&#xE8F4;" Command="{Binding NewFolderCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="New folder" />
                        <Button Content="&#xE8AC;" Command="{Binding RenameFolderCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Rename folder" />
                        <Button Content="&#xE8DE;" Command="{Binding MoveFolderCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Move folder" />
                        <Button Content="&#xE74D;" Command="{Binding DeleteFolderCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Delete folder (prompts move to Unfiled)" />
                    </StackPanel>
                    <TreeView ItemsSource="{Binding FolderTree}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              Background="Transparent"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#B8C9D0" />

            <Border Grid.Column="2" Background="{StaticResource CenterBrush}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="&#xE8DE;" DockPanel.Dock="Right" Command="{Binding MoveSelectedCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Move selected prompts" />
                        <TextBlock Text="{Binding RegisterTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource MutedInkBrush}" Margin="12,4,0,0" />
                    </DockPanel>

                    <DataGrid x:Name="PromptGrid" Grid.Row="1"
                              ItemsSource="{Binding Prompts}"
                              SelectedItem="{Binding SelectedPrompt}"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionChanged="PromptGrid_SelectionChanged"
                              MouseDoubleClick="PromptGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="2*" MinWidth="180" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="95" />
                            <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="130" />
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionLabel}" SortMemberPath="Version" Width="70" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding UpdatedAt, StringFormat={}{0:g}}" Width="140" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="110" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Labels" Binding="{Binding Labels}" Width="120" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Path" Binding="{Binding FolderPath}" Width="150" Visibility="Collapsed" />
                            <DataGridCheckBoxColumn Header="Favorite" Binding="{Binding IsFavorite}" Width="80" Visibility="Collapsed" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#B8C9D0" />

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Unsaved" DockPanel.Dock="Right" Foreground="#884B58" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Properties" FontSize="18" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SelectedPrompt.Title, TargetNullValue='No prompt selected'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPrompt.FolderPath}" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TabControl x:Name="EditorTabs" Grid.Row="2" Margin="0,0,0,10">
                        <TabItem Header="Details">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Title" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SelectedPrompt.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" IsEnabled="{Binding HasSelection}" />

                                    <TextBlock Text="Type" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding TypeOptions}"
                                              Text="{Binding SelectedPrompt.Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              Margin="0,4,0,10"
                                              IsEnabled="{Binding HasSelection}" />

                                    <TextBlock Text="Mode" FontWeight="SemiBold" />
                                    <DockPanel Margin="0,4,0,10">
                                        <Button Content="Template"
                                                Command="{Binding ApplyModeTemplateCommand}"
                                                DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Padding="10,4"
                                                IsEnabled="{Binding HasSelection}" />
                                        <ComboBox ItemsSource="{Binding ModeOptions}"
                                                  SelectedItem="{Binding SelectedPrompt.Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding HasSelection}" />
                                    </DockPanel>

                                    <TextBlock Text="Path" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding FolderOptions}"
                                              DisplayMemberPath="Path"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedPromptFolderOptionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,4,0,10"
                                              IsEnabled="{Binding HasSelection}" />

                                    <TextBlock Text="Tags" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SelectedPrompt.Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" IsEnabled="{Binding HasSelection}" />

                                    <TextBlock Text="Labels" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SelectedPrompt.Labels, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6" IsEnabled="{Binding HasSelection}" />
                                    <DockPanel Margin="0,0,0,10">
                                        <Button Content="Add"
                                                Command="{Binding AddLabelCommand}"
                                                DockPanel.Dock="Right"
                                                Margin="8,0,0,0"
                                                Padding="12,4"
                                                IsEnabled="{Binding HasSelection}" />
                                        <ComboBox ItemsSource="{Binding LabelOptions}"
                                                  SelectedItem="{Binding SelectedLabelToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding HasSelection}" />
                                    </DockPanel>

                                    <TextBlock Text="Status" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedPrompt.Status}" Margin="0,4,0,12" IsEnabled="{Binding HasSelection}" />

                                    <Border Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Document Control" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding SelectedPrompt.VersionLabel, StringFormat='Version: {0}', TargetNullValue='Version: -'}" />
                                            <TextBlock Text="{Binding SelectedPrompt.UpdatedAt, StringFormat='Last Modified: {0:g}', TargetNullValue='Last Modified: -'}" />
                                            <TextBlock Text="{Binding SelectedPrompt.LastUsedAt, StringFormat='Last Used: {0:g}', TargetNullValue='Last Used: -'}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Notes">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#EEF6F2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,1,0" Padding="6,5">
                                    <DockPanel>
                                        <Button Content="&#xE740;" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" ToolTip="Expand Notes editor" Click="ExpandNotes_Click" IsEnabled="{Binding HasSelection}" />
                                        <ComboBox x:Name="EditorFontSize" DockPanel.Dock="Right" Width="62" ToolTip="Reading size" SelectionChanged="EditorFontSize_SelectionChanged" Margin="6,0,6,0">
                                            <ComboBoxItem Content="12" /><ComboBoxItem Content="14" /><ComboBoxItem Content="16" IsSelected="True" /><ComboBoxItem Content="18" /><ComboBoxItem Content="20" /><ComboBoxItem Content="24" />
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal">
                                        <Button x:Name="NotesBoldButton"
                                                Content="B"
                                                Width="30"
                                                Padding="0,4"
                                                Margin="0,0,4,0"
                                                FontWeight="Bold"
                                                ToolTip="Bold"
                                                Click="NotesBoldButton_Click"
                                                IsEnabled="{Binding HasSelection}" />
                                        <Button x:Name="NotesItalicButton"
                                                Content="I"
                                                Width="30"
                                                Padding="0,4"
                                                Margin="0,0,8,0"
                                                FontStyle="Italic"
                                                ToolTip="Italic"
                                                Click="NotesItalicButton_Click"
                                                IsEnabled="{Binding HasSelection}" />
                                        <ComboBox x:Name="NotesColorComboBox"
                                                  Width="82"
                                                  SelectionChanged="NotesColorComboBox_SelectionChanged"
                                                  IsEnabled="{Binding HasSelection}">
                                            <ComboBoxItem Tag="#263238"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="#263238" Margin="0,0,5,0" /><TextBlock Text="Ink" /></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="#1E5C7A"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="#1E5C7A" Margin="0,0,5,0" /><TextBlock Text="Blue" /></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="#1F6B50"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="#1F6B50" Margin="0,0,5,0" /><TextBlock Text="Green" /></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="#884B58"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="#884B58" Margin="0,0,5,0" /><TextBlock Text="Rose" /></StackPanel></ComboBoxItem>
                                            <ComboBoxItem Tag="#65558F"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="#65558F" Margin="0,0,5,0" /><TextBlock Text="Violet" /></StackPanel></ComboBoxItem>
                                        </ComboBox>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <RichTextBox x:Name="PromptNotesEditor"
                                             Grid.Row="1"
                                             MinHeight="100"
                                             FontSize="16"
                                             BorderBrush="{StaticResource LineBrush}"
                                             BorderThickness="1"
                                             Padding="10"
                                             VerticalScrollBarVisibility="Auto"
                                             TextChanged="PromptNotesEditor_TextChanged"
                                             IsEnabled="{Binding HasSelection}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Prompt">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Button Content="&#xE740;" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" ToolTip="Expand Prompt editor" Click="ExpandPrompt_Click" IsEnabled="{Binding HasSelection}" />
                                    <Button Content="Insert Variable"
                                            DockPanel.Dock="Right"
                                            Padding="10,4"
                                            Margin="8,0,0,0"
                                            Click="InsertVariableButton_Click"
                                            IsEnabled="{Binding HasSelection}" />
                                    <TextBlock Text="Prompt Text" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBox x:Name="PromptBodyTextBox"
                                         Grid.Row="1"
                                         Text="{Binding SelectedPrompt.Body, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="100"
                                         FontSize="16"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Margin="0,0,0,12"
                                         IsEnabled="{Binding HasSelection}" />

                                <Button Grid.Row="2" Content="Fill Variables and Copy" Command="{Binding FillVariablesCommand}" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Review">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12">
                                    <Border Background="#EEF6F2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Review Checks" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBlock Text="Quality" Foreground="{StaticResource MutedInkBrush}" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding QualityIssues}" Margin="0,2,0,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='- {0}'}" TextWrapping="Wrap" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Duplicates" Foreground="{StaticResource MutedInkBrush}" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding DuplicateWarnings}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='- {0}'}" TextWrapping="Wrap" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Versions">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="DisplayName" Margin="0,0,0,10" />
                                <TabControl Grid.Row="1">
                                    <TabItem Header="Differences"><TextBox Text="{Binding VersionComparisonText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" /></TabItem>
                                    <TabItem Header="Saved Text"><TextBox Text="{Binding SelectedVersion.Body, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="16" /></TabItem>
                                </TabControl>
                                <Button Grid.Row="2" Content="Restore Revision as Draft" Command="{Binding RestoreVersionCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0" />
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <DockPanel Grid.Row="3" Margin="0,0,0,8">
                        <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center"><MenuItem Header="More"><MenuItem Header="Toggle Favorite" Command="{Binding ToggleFavoriteCommand}" /><MenuItem Header="Archive" Command="{Binding ArchiveCommand}" /><MenuItem Header="Restore from Archive" Command="{Binding RestorePromptCommand}" /><Separator /><MenuItem Header="Delete Permanently" Command="{Binding DeleteCommand}" /></MenuItem></Menu>
                        <Button Content="&#xE74E;" Command="{Binding SaveCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Save revision (Ctrl+S)" Background="{StaticResource AccentBrush}" />
                        <Button Content="&#xE8C8;" Command="{Binding CopyCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Copy prompt text" HorizontalAlignment="Left" />
                    </DockPanel>

                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding StatusMessage}" />
                </Grid>
            </Border>        </Grid>

        <Border Grid.Row="3" Background="#E9F2EE" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <TextBlock Text="{Binding DatabasePath}" Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>







