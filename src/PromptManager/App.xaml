<Application x:Class="PromptManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="InkColor">#21313D</Color>
        <Color x:Key="MutedInkColor">#40535D</Color>
        <Color x:Key="ShellTopColor">#809DB0</Color>
        <Color x:Key="ShellTopDarkColor">#55778F</Color>
        <Color x:Key="NavColor">#C7DDEB</Color>
        <Color x:Key="NavSelectedColor">#A9CEDD</Color>
        <Color x:Key="CenterColor">#EEF7F8</Color>
        <Color x:Key="PanelColor">#FFF6DC</Color>
        <Color x:Key="PanelInsetColor">#FFFBEF</Color>
        <Color x:Key="AccentColor">#8FBDA6</Color>
        <Color x:Key="AccentDarkColor">#5F9279</Color>
        <Color x:Key="RoseColor">#F2C6C2</Color>
        <Color x:Key="LineColor">#B7C8CE</Color>

        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}" />
        <SolidColorBrush x:Key="ShellTopBrush" Color="{StaticResource ShellTopColor}" />
        <SolidColorBrush x:Key="ShellTopDarkBrush" Color="{StaticResource ShellTopDarkColor}" />
        <SolidColorBrush x:Key="NavBrush" Color="{StaticResource NavColor}" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}" />
        <SolidColorBrush x:Key="CenterBrush" Color="{StaticResource CenterColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="PanelInsetBrush" Color="{StaticResource PanelInsetColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
        <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Background" Value="#E7F0EA" />
            <Setter Property="BorderBrush" Value="#5F7F91" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AlternatingRowBackground" Value="#F8FCFC" />
            <Setter Property="Background" Value="{StaticResource CenterBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D7E8EA" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Application.Resources>
</Application>

