<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PromptManagerSetup</AssemblyName>
    <RootNamespace>PromptManagerSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\artifacts\installer\payload.zip" LogicalName="PromptManagerSetup.Payload.zip" />
  </ItemGroup>
</Project>

